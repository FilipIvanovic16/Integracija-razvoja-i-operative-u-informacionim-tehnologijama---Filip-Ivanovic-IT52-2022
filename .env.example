# Kopiraj ovaj fajl u .env pre "docker compose up -d".
# Ako .env ne postoji, koriste se podrazumevane vrednosti iz docker-compose.yml.

# ====== PostgreSQL (deljena instanca, 4 baze - vidi infra/postgres/init-databases.sh) ======
POSTGRES_USER=chronoshop
POSTGRES_PASSWORD=chronoshop

# ====== RabbitMQ ======
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ====== JWT (isti kljuc izdaje auth-service, verifikuje api-gateway) ======
JWT_SECRET=Z2VuZXJpc2FuLXRham5pLWtsanVjLXphLWNocm9ub3Nob3AtMjAyNi1lb25pcw==
JWT_EXPIRATION_MS=86400000

# ====== Stripe (test mode) ======
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ====== CORS ======
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ====== Seed demo podataka (admin@chronoshop.rs / kupac@chronoshop.rs, katalog) ======
SEED_ENABLED=true
