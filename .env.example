# ====== Docker Compose konfiguracija ======
# Kopiraj ovaj fajl u .env i po potrebi izmeni vrednosti.
# (Ako .env ne postoji, koriste se podrazumevane vrednosti iz docker-compose.yml.)

# Lozinka SQL Server 'sa' naloga (mora biti "jaka": velika/mala slova, broj, simbol)
SA_PASSWORD=Your_strong_Pass123

# Base64 tajni ključ za JWT
JWT_SECRET=Z2VuZXJpc2FuLXRham5pLWtsanVjLXphLWNocm9ub3Nob3AtMjAyNi1lb25pcw==

# Stripe (test mode) ključevi
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
